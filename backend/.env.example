# ── Knowlix Backend Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is excluded by .gitignore.

# Groq API key (https://console.groq.com/keys). Required for LLM answers;
# without it the backend answers with the extractive fallback only.
# The key is read from the environment at runtime — never hardcode it.
GROQ_API_KEY=

# Groq model (optional — default shown)
# GROQ_MODEL=openai/gpt-oss-120b

# Retrieval & guardrails (optional — defaults shown)
MIN_RETRIEVAL_SCORE=0.40
MIN_CLAIM_SUPPORT_RATIO=0.34
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=500
RRF_K=60

# Chunking settings (optional — defaults shown)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# RETRIEVER_TOP_K=4

# ── Semantic Cache Engine Configuration ───────────────────────────────────────
# Optional Redis connection string (e.g. redis://default:password@host:port)
# When unset, Knowlix falls back automatically to bounded in-memory LRU caching.
REDIS_URL=

# Cache thresholds & lifecycle
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=1000
